// Staging and branch Previews (docs/DEPLOY.md, Staging). CI deploys `main` to preview.magnetar.codefusion.cc
// (`wrangler deploy -c wrangler.preview.jsonc`) and every pull request to its own Worker Preview at
// https://<branch>.preview.magnetar.codefusion.cc (`wrangler preview`, the `previews` block below), each with its own
// D1 database and DeviceRelay objects. Closing the pull request deletes its Preview and database. Nothing here
// reaches production's database, relay, secrets or sign-in.
//
// Staging and Previews sign in with their own Google OAuth client, never production's: a page that gets a
// production client's token can sign its holder in to magnetar.codefusion.cc, and Previews run code nobody merged.
// environments.test.ts keeps the two clients apart. Previews have no fixed hostname for Google to return to, so they
// sign in through staging's callback (GOOGLE_CALLBACK_ORIGIN); only staging sets AUTH_PREVIEW_PARENTS, which lets
// that callback return a token to <branch>.preview.magnetar.codefusion.cc.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "magnetar-preview",
  // The CodeFusion account, which @codefusion-cc/previews reads to make and delete branch databases.
  "account_id": "112334c23f627b8dabd4ff94c2b1b90d",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Also serves every Preview at <preview name>.preview.magnetar.codefusion.cc.
  "routes": [{ "pattern": "preview.magnetar.codefusion.cc", "custom_domain": true, "previews_enabled": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    // As in wrangler.jsonc, and the home page through the Worker too, so every page here is marked noindex.
    "run_worker_first": ["/_console/*", "/"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "magnetar-preview", "database_id": "567db2ce-5b5d-4783-af98-56a307d8058f", "migrations_dir": "migrations" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "DeviceRelay" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DeviceRelay"] }],
  "ratelimits": [
    { "name": "PAIR_LIMITER", "namespace_id": "3111", "simple": { "limit": 10, "period": 60 } },
    { "name": "AUTH_LIMITER", "namespace_id": "3112", "simple": { "limit": 20, "period": 60 } },
    { "name": "TELEMETRY_LIMITER", "namespace_id": "3113", "simple": { "limit": 10, "period": 60 } },
    { "name": "PUSH_LIMITER", "namespace_id": "3114", "simple": { "limit": 120, "period": 60 } },
    { "name": "BROWSER_FAILURE_RATE_LIMITER", "namespace_id": "3115", "simple": { "limit": 10, "period": 60 } }
  ],
  // CodeFusion Console's page views, filed under this deployment's APP_ENV. Previews count none.
  "analytics_engine_datasets": [{ "binding": "VISITS", "dataset": "cfc_visits" }],
  "observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "invocation_logs": false } },
  // CodeFusion Console files this Worker as Magnetar's staging (its config/apps.json). It has no ConsoleAdmin
  // binding to it: the console's account pages are production's.
  "tail_consumers": [{ "service": "codefusion-console" }],
  "services": [{ "binding": "CONSOLE_TELEMETRY", "service": "codefusion-console", "entrypoint": "AppTelemetry" }],
  "vars": {
    "APP_ID": "magnetar",
    "APP_ENV": "staging",
    "ORIGIN": "https://preview.magnetar.codefusion.cc",
    // The staging OAuth client "Magnetar staging" (docs/DEPLOY.md, Staging), shared with the Previews.
    "GOOGLE_CLIENT_ID": "724645084534-e29vc126dvuodlnh3hfrbkggnmbsqg0j.apps.googleusercontent.com",
    // Google's callback here may hand a token to a Preview (src/env.ts `googleReturnOrigin`). Never set it in
    // wrangler.jsonc or in the `previews` block.
    "AUTH_PREVIEW_PARENTS": "enabled"
  },
  // Branch Previews. Nothing above is inherited but the assets, compatibility settings and Durable Object
  // migrations. Each Preview gets its own DeviceRelay namespace from Cloudflare and its own database from
  // `codefusion-previews up`, which replaces the placeholder id and origin below. Secrets come from the Previews
  // base config (`wrangler preview base-config secret put`).
  "previews": {
    "vars": {
      "APP_ID": "magnetar",
      "APP_ENV": "preview",
      "ORIGIN": "https://preview-origin.invalid",
      "GOOGLE_CLIENT_ID": "724645084534-e29vc126dvuodlnh3hfrbkggnmbsqg0j.apps.googleusercontent.com",
      "GOOGLE_CALLBACK_ORIGIN": "https://preview.magnetar.codefusion.cc"
    },
    "d1_databases": [
      { "binding": "DB", "database_name": "magnetar-previews", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
    ],
    "durable_objects": {
      "bindings": [{ "name": "RELAY", "class_name": "DeviceRelay" }]
    },
    "ratelimits": [
      { "name": "PAIR_LIMITER", "namespace_id": "3121", "simple": { "limit": 10, "period": 60 } },
      { "name": "AUTH_LIMITER", "namespace_id": "3122", "simple": { "limit": 20, "period": 60 } },
      { "name": "TELEMETRY_LIMITER", "namespace_id": "3123", "simple": { "limit": 10, "period": 60 } },
      { "name": "PUSH_LIMITER", "namespace_id": "3124", "simple": { "limit": 120, "period": 60 } },
      { "name": "BROWSER_FAILURE_RATE_LIMITER", "namespace_id": "3125", "simple": { "limit": 10, "period": 60 } }
    ],
    // Failures from Previews reach the console too, filed as preview with their branch.
    "tail_consumers": [{ "service": "codefusion-console" }],
    "services": [{ "binding": "CONSOLE_TELEMETRY", "service": "codefusion-console", "entrypoint": "AppTelemetry" }]
  }
}
