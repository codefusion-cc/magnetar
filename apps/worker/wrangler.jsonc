// magnetar.codefusion.cc: the website, Google sign-in, device pairing, and the relay that
// joins browsers to devices. The relay only ever sees end-to-end encrypted frames.
//
// Production is the top level, the preview Worker at preview.magnetar.codefusion.cc is `env.preview`, and `env.dev` is
// for `wrangler dev` and the tests. Each copy has its own D1 database, DeviceRelay objects, rate limits, secrets and
// sign-in; environments.test.ts keeps them apart.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "magnetar",
  // The CodeFusion account, which @codefusion-cc/previews reads to make and delete branch databases.
  "account_id": "112334c23f627b8dabd4ff94c2b1b90d",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Production answers only on its own domain: no workers.dev or preview hostnames.
  "routes": [{ "pattern": "magnetar.codefusion.cc", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    // No not_found_handling: a path that is no file reaches the Worker, which answers it with the dashboard's page
    // (docs/ARCHITECTURE.md). The default html_handling answers /index itself, a reserved device name. Only the
    // Worker reads the console's source maps (dist/_console/), and it answers 404 there.
    "run_worker_first": ["/_console/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "magnetar", "database_id": "04dff4c8-e6b5-48e1-94b0-2769261e8a70", "migrations_dir": "migrations" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "DeviceRelay" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DeviceRelay"] }],
  "ratelimits": [
    { "name": "PAIR_LIMITER", "namespace_id": "3101", "simple": { "limit": 10, "period": 60 } },
    { "name": "AUTH_LIMITER", "namespace_id": "3102", "simple": { "limit": 20, "period": 60 } },
    { "name": "TELEMETRY_LIMITER", "namespace_id": "3103", "simple": { "limit": 10, "period": 60 } },
    { "name": "PUSH_LIMITER", "namespace_id": "3104", "simple": { "limit": 120, "period": 60 } },
    { "name": "BROWSER_FAILURE_RATE_LIMITER", "namespace_id": "3105", "simple": { "limit": 10, "period": 60 } }
  ],
  // CodeFusion Console's page views (POST /api/visits): its shared dataset, no personal data.
  "analytics_engine_datasets": [{ "binding": "VISITS", "dataset": "cfc_visits" }],
  "observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "invocation_logs": false } },
  // CodeFusion Console: one trace per invocation, and website and desktop failures via AppTelemetry. The console
  // reaches accounts and devices through the ConsoleAdmin entrypoint (src/console/).
  "tail_consumers": [{ "service": "codefusion-console" }],
  "services": [{ "binding": "CONSOLE_TELEMETRY", "service": "codefusion-console", "entrypoint": "AppTelemetry" }],
  "vars": {
    "APP_ID": "magnetar",
    "APP_ENV": "production",
    "ORIGIN": "https://magnetar.codefusion.cc",
    // The OAuth client created for this app in Google Cloud Console (public; no client secret is used).
    "GOOGLE_CLIENT_ID": "724645084534-gg1qlhb0htm981ogdl430hsd6qfa80nu.apps.googleusercontent.com"
    // Web Push: the VAPID key is a secret, made and stored as docs/DEPLOY.md says (Browser notifications).
    // Without it browser notifications are off.
  },
  "env": {
    // The preview Worker (docs/DEPLOY.md, Preview). CI deploys `main` here with `--env preview` before production, and
    // every pull request to its own Worker Preview at https://<branch>.preview.magnetar.codefusion.cc
    // (`wrangler preview --env preview`, the `previews` block below), each with its own D1 database and DeviceRelay
    // objects. Closing the pull request deletes its Preview and database. Nothing here reaches production's database,
    // relay, secrets or sign-in.
    //
    // The preview Worker and its Previews sign in with their own Google OAuth client, never production's: a page that
    // gets a production client's token can sign its holder in to magnetar.codefusion.cc, and Previews run code nobody
    // merged. Previews have no fixed hostname for Google to return to, so they sign in through the preview Worker's
    // callback (GOOGLE_CALLBACK_ORIGIN); only the preview Worker sets AUTH_PREVIEW_PARENTS, which lets that callback
    // return a token to <branch>.preview.magnetar.codefusion.cc.
    "preview": {
      "name": "magnetar-preview",
      // Also serves every Preview at <preview name>.preview.magnetar.codefusion.cc.
      "routes": [{ "pattern": "preview.magnetar.codefusion.cc", "custom_domain": true, "previews_enabled": true }],
      "workers_dev": false,
      "preview_urls": false,
      "assets": {
        "directory": "../web/dist",
        "binding": "ASSETS",
        // As at the top level, and the home page through the Worker too, so every page here is marked noindex.
        "run_worker_first": ["/_console/*", "/"]
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "magnetar-preview", "database_id": "567db2ce-5b5d-4783-af98-56a307d8058f", "migrations_dir": "migrations" }
      ],
      "durable_objects": {
        "bindings": [{ "name": "RELAY", "class_name": "DeviceRelay" }]
      },
      "ratelimits": [
        { "name": "PAIR_LIMITER", "namespace_id": "3111", "simple": { "limit": 10, "period": 60 } },
        { "name": "AUTH_LIMITER", "namespace_id": "3112", "simple": { "limit": 20, "period": 60 } },
        { "name": "TELEMETRY_LIMITER", "namespace_id": "3113", "simple": { "limit": 10, "period": 60 } },
        { "name": "PUSH_LIMITER", "namespace_id": "3114", "simple": { "limit": 120, "period": 60 } },
        { "name": "BROWSER_FAILURE_RATE_LIMITER", "namespace_id": "3115", "simple": { "limit": 10, "period": 60 } }
      ],
      // CodeFusion Console's page views, filed under this copy's APP_ENV. Previews count none.
      "analytics_engine_datasets": [{ "binding": "VISITS", "dataset": "cfc_visits" }],
      // CodeFusion Console counts this Worker as Magnetar's preview. It has no ConsoleAdmin binding to it: the
      // console's account pages are production's.
      "tail_consumers": [{ "service": "codefusion-console" }],
      "services": [{ "binding": "CONSOLE_TELEMETRY", "service": "codefusion-console", "entrypoint": "AppTelemetry" }],
      "vars": {
        "APP_ID": "magnetar",
        "APP_ENV": "preview",
        "ORIGIN": "https://preview.magnetar.codefusion.cc",
        // The OAuth client "Magnetar staging" (docs/DEPLOY.md, Preview), shared with the Previews.
        "GOOGLE_CLIENT_ID": "724645084534-e29vc126dvuodlnh3hfrbkggnmbsqg0j.apps.googleusercontent.com",
        // Google's callback here may hand a token to a Preview (src/env.ts `googleReturnOrigin`). Never set it at the
        // top level or in the `previews` block.
        "AUTH_PREVIEW_PARENTS": "enabled"
      },
      // Branch Previews. Nothing above is inherited but the assets, compatibility settings and Durable Object
      // migrations. Each Preview gets its own DeviceRelay namespace from Cloudflare and its own database from
      // `codefusion-previews up`, which replaces the placeholder id and origin below. Secrets come from the Previews
      // base config (`wrangler preview base-config secret put --env preview`).
      "previews": {
        "vars": {
          "APP_ID": "magnetar",
          "APP_ENV": "preview",
          "ORIGIN": "https://preview-origin.invalid",
          "GOOGLE_CLIENT_ID": "724645084534-e29vc126dvuodlnh3hfrbkggnmbsqg0j.apps.googleusercontent.com",
          "GOOGLE_CALLBACK_ORIGIN": "https://preview.magnetar.codefusion.cc"
        },
        "d1_databases": [
          { "binding": "DB", "database_name": "magnetar-previews", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
        ],
        "durable_objects": {
          "bindings": [{ "name": "RELAY", "class_name": "DeviceRelay" }]
        },
        "ratelimits": [
          { "name": "PAIR_LIMITER", "namespace_id": "3121", "simple": { "limit": 10, "period": 60 } },
          { "name": "AUTH_LIMITER", "namespace_id": "3122", "simple": { "limit": 20, "period": 60 } },
          { "name": "TELEMETRY_LIMITER", "namespace_id": "3123", "simple": { "limit": 10, "period": 60 } },
          { "name": "PUSH_LIMITER", "namespace_id": "3124", "simple": { "limit": 120, "period": 60 } },
          { "name": "BROWSER_FAILURE_RATE_LIMITER", "namespace_id": "3125", "simple": { "limit": 10, "period": 60 } }
        ],
        // Failures from Previews reach the console too, filed as preview with their branch.
        "tail_consumers": [{ "service": "codefusion-console" }],
        "services": [{ "binding": "CONSOLE_TELEMETRY", "service": "codefusion-console", "entrypoint": "AppTelemetry" }]
      }
    },
    // `wrangler dev --env dev`: a passwordless dev sign-in, local D1, no console.
    "dev": {
      "routes": [],
      "workers_dev": true,
      "d1_databases": [
        { "binding": "DB", "database_name": "magnetar", "database_id": "04dff4c8-e6b5-48e1-94b0-2769261e8a70", "migrations_dir": "migrations" }
      ],
      "durable_objects": { "bindings": [{ "name": "RELAY", "class_name": "DeviceRelay" }] },
      "ratelimits": [
        { "name": "PAIR_LIMITER", "namespace_id": "3101", "simple": { "limit": 100, "period": 60 } },
        { "name": "AUTH_LIMITER", "namespace_id": "3102", "simple": { "limit": 100, "period": 60 } },
        { "name": "TELEMETRY_LIMITER", "namespace_id": "3103", "simple": { "limit": 100, "period": 60 } },
        { "name": "PUSH_LIMITER", "namespace_id": "3104", "simple": { "limit": 600, "period": 60 } },
        { "name": "BROWSER_FAILURE_RATE_LIMITER", "namespace_id": "3105", "simple": { "limit": 100, "period": 60 } }
      ],
      "tail_consumers": [],
      "services": [],
      "vars": {
        "APP_ID": "magnetar",
        "APP_ENV": "development",
        "ORIGIN": "http://localhost:8790",
        "GOOGLE_CLIENT_ID": "",
        "DEV_LOGIN": "enabled"
      }
    }
  }
}
